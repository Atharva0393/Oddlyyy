# =========================================================================
# ODDLYYY STUDIO: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the values below.
# =========================================================================

# 1. Resend API Credentials (Required for Contact Form Email Delivery)
# Obtain your key at https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 2. Recipient Email Address for Inbound Client Inquiries
# Defaults to hello@oddlyyy.studio if left blank
CONTACT_TO_EMAIL=hello@oddlyyy.studio

# 3. Verified Sender Email
# For testing before custom domain DNS verification, use: onboarding@resend.dev
# Once oddly.com domain is verified in Resend, use: Oddlyyy Studio <inquiries@oddly.com>
CONTACT_FROM_EMAIL=Oddlyyy Inquiries <onboarding@resend.dev>

# 4. Optional Custom Site URL Override (Production / Preview)
# NEXT_PUBLIC_SITE_URL=https://oddlyyy.vercel.app

